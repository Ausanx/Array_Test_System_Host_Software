<Application x:Class="ArrayCamera.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 浅色专业主题 - 匹配 WinForms 项目 -->
        <SolidColorBrush x:Key="PrimaryBrush"
                Color="#3B82F6"/>
        <SolidColorBrush x:Key="SuccessBrush"
                Color="#22C55E"/>
        <SolidColorBrush x:Key="DangerBrush"
                Color="#EF4444"/>
        <SolidColorBrush x:Key="NeutralBrush"
                Color="#64748B"/>
        <SolidColorBrush x:Key="BackgroundBrush"
                Color="#F0F2F5"/>
        <SolidColorBrush x:Key="SurfaceBrush"
                Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HeatmapBgBrush"
                Color="#0F172A"/>
        <SolidColorBrush x:Key="BorderBrush"
                Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"
                Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"
                Color="#475569"/>
        <SolidColorBrush x:Key="InputBgBrush"
                Color="#F8FAFC"/>
    </Application.Resources>
</Application>
