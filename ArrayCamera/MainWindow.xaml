<Window x:Class="ArrayCamera.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="交叉阵列测试系统 - Array Test System v1.2"
        Height="900"
        Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

        <Window.Resources>
                <!-- 通用样式 -->
                <Style x:Key="LabelStyle"
                       TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="#333333"/>
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="VerticalAlignment"
                                Value="Center"/>
                </Style>

                <Style x:Key="InputStyle"
                       TargetType="TextBox">
                        <Setter Property="Height"
                                Value="28"/>
                        <Setter Property="Padding"
                                Value="8,4"/>
                        <Setter Property="BorderBrush"
                                Value="#CCCCCC"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Background"
                                Value="White"/>
                        <Setter Property="Foreground"
                                Value="#333333"/>
                </Style>

                <Style x:Key="ComboStyle"
                       TargetType="ComboBox">
                        <Setter Property="Height"
                                Value="28"/>
                        <Setter Property="Padding"
                                Value="8,4"/>
                        <Setter Property="BorderBrush"
                                Value="#CCCCCC"/>
                        <Setter Property="Background"
                                Value="White"/>
                        <Setter Property="Foreground"
                                Value="#333333"/>
                </Style>

                <Style x:Key="GroupBoxStyle"
                       TargetType="GroupBox">
                        <Setter Property="BorderBrush"
                                Value="#E0E0E0"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Margin"
                                Value="0,0,0,12"/>
                        <Setter Property="Padding"
                                Value="12,8"/>
                        <Setter Property="Foreground"
                                Value="#333333"/>
                        <Setter Property="FontWeight"
                                Value="Medium"/>
                </Style>

                <Style x:Key="PrimaryButton"
                       TargetType="Button">
                        <Setter Property="Height"
                                Value="36"/>
                        <Setter Property="Background"
                                Value="#2196F3"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="FontWeight"
                                Value="Medium"/>
                </Style>

                <Style x:Key="SuccessButton"
                       TargetType="Button">
                        <Setter Property="Height"
                                Value="36"/>
                        <Setter Property="Background"
                                Value="#4CAF50"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="FontWeight"
                                Value="Medium"/>
                </Style>

                <Style x:Key="DangerButton"
                       TargetType="Button">
                        <Setter Property="Height"
                                Value="36"/>
                        <Setter Property="Background"
                                Value="#F44336"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="FontWeight"
                                Value="Medium"/>
                </Style>
        </Window.Resources>

        <Grid Margin="12">
                <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <!-- 主内容区 -->
                <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="420"/>
                        </Grid.ColumnDefinitions>

                        <!-- ==================== 左侧：热力图显示区域 ==================== -->
                        <Border Grid.Column="0"
                                Background="#FFFFFF"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,12,0">
                                <Grid>
                                        <Image x:Name="HeatmapImage"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                        <!-- 右上角状态指示器 -->
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="16"
                                                Background="#FFFFFF"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12,6">
                                                <StackPanel Orientation="Horizontal">
                                                        <Ellipse x:Name="StatusIndicator"
                                                                 Width="10"
                                                                 Height="10"
                                                                 Fill="#4CAF50"
                                                                 Margin="0,0,8,0"/>
                                                        <TextBlock x:Name="StatusText"
                                                                   Text="演示模式"
                                                                   FontSize="12"
                                                                   Foreground="#333333"/>
                                                </StackPanel>
                                        </Border>

                                        <!-- 底部信息栏 -->
                                        <Border VerticalAlignment="Bottom"
                                                Background="#FFFFFF"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="0,1,0,0"
                                                Padding="16,10">
                                                <Grid>
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Left">
                                                                <TextBlock Text="分辨率: 512×512"
                                                                           Style="{StaticResource LabelStyle}"
                                                                           Margin="0,0,24,0"/>
                                                                <TextBlock Text="刷新率: 30 FPS"
                                                                           Style="{StaticResource LabelStyle}"
                                                                           Margin="0,0,24,0"/>
                                                                <TextBlock x:Name="MousePosText"
                                                                           Text="位置: (-, -)"
                                                                           Style="{StaticResource LabelStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                                <TextBlock Text="TX:"
                                                                           Style="{StaticResource LabelStyle}"
                                                                           Margin="0,0,4,0"/>
                                                                <TextBlock x:Name="TxCountText"
                                                                           Text="0"
                                                                           Style="{StaticResource LabelStyle}"
                                                                           FontWeight="Bold"
                                                                           Margin="0,0,16,0"/>
                                                                <TextBlock Text="RX:"
                                                                           Style="{StaticResource LabelStyle}"
                                                                           Margin="0,0,4,0"/>
                                                                <TextBlock x:Name="RxCountText"
                                                                           Text="0"
                                                                           Style="{StaticResource LabelStyle}"
                                                                           FontWeight="Bold"/>
                                                        </StackPanel>
                                                </Grid>
                                        </Border>
                                </Grid>
                        </Border>

                        <!-- ==================== 右侧：控制面板 ==================== -->
                        <Border Grid.Column="1"
                                Background="#FFFFFF"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>

                                                <!-- A. 连接设置 -->
                                                <GroupBox Header="A. 连接设置 (Connection)"
                                                          Style="{StaticResource GroupBoxStyle}">
                                                        <StackPanel>
                                                                <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="80"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="目标 IP:"
                                                                                   Style="{StaticResource LabelStyle}"/>
                                                                        <TextBox Grid.Column="1"
                                                                                 x:Name="TxtIp"
                                                                                 Text="192.168.2.88"
                                                                                 Style="{StaticResource InputStyle}"/>
                                                                </Grid>

                                                                <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="80"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="端口:"
                                                                                   Style="{StaticResource LabelStyle}"/>
                                                                        <TextBox Grid.Column="1"
                                                                                 x:Name="TxtPort"
                                                                                 Text="8080"
                                                                                 Style="{StaticResource InputStyle}"/>
                                                                </Grid>

                                                                <Button x:Name="BtnConnect"
                                                                        Content="连接 / 绑定"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="BtnConnect_Click"/>

                                                                <Grid Margin="0,8,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="80"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="连接状态:"
                                                                                   Style="{StaticResource LabelStyle}"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   x:Name="NetworkStatusText"
                                                                                   Text="未连接"
                                                                                   Foreground="#F44336"
                                                                                   FontWeight="Medium"/>
                                                                </Grid>
                                                        </StackPanel>
                                                </GroupBox>

                                                <!-- B. 系统模式 -->
                                                <GroupBox Header="B. 系统模式 (System Mode)"
                                                          Style="{StaticResource GroupBoxStyle}">
                                                        <StackPanel>
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="演示仿真模式"
                                                                                   Style="{StaticResource LabelStyle}"/>
                                                                        <ToggleButton Grid.Column="1"
                                                                                      x:Name="TgDemo"
                                                                                      IsChecked="False"
                                                                                      Width="50"
                                                                                      Height="24"
                                                                                      Checked="TgDemo_Changed"
                                                                                      Unchecked="TgDemo_Changed">
                                                                                <ToggleButton.Style>
                                                                                        <Style TargetType="ToggleButton">
                                                                                                <Setter Property="Template">
                                                                                                        <Setter.Value>
                                                                                                                <ControlTemplate TargetType="ToggleButton">
                                                                                                                        <Border x:Name="SwitchBorder"
                                                                                                                                Background="#E0E0E0"
                                                                                                                                CornerRadius="12"
                                                                                                                                Padding="2">
                                                                                                                                <Ellipse x:Name="SwitchCircle"
                                                                                                                                         Width="20"
                                                                                                                                         Height="20"
                                                                                                                                         Fill="White"
                                                                                                                                         HorizontalAlignment="Left"/>
                                                                                                                        </Border>
                                                                                                                        <ControlTemplate.Triggers>
                                                                                                                                <Trigger Property="IsChecked"
                                                                                                                                         Value="True">
                                                                                                                                        <Setter TargetName="SwitchBorder"
                                                                                                                                                Property="Background"
                                                                                                                                                Value="#4CAF50"/>
                                                                                                                                        <Setter TargetName="SwitchCircle"
                                                                                                                                                Property="HorizontalAlignment"
                                                                                                                                                Value="Right"/>
                                                                                                                                </Trigger>
                                                                                                                        </ControlTemplate.Triggers>
                                                                                                                </ControlTemplate>
                                                                                                        </Setter.Value>
                                                                                                </Setter>
                                                                                        </Style>
                                                                                </ToggleButton.Style>
                                                                        </ToggleButton>
                                                                </Grid>
                                                                <TextBlock Text="开启时使用软件仿真，不连接硬件"
                                                                           Foreground="#888888"
                                                                           FontSize="11"
                                                                           Margin="0,6,0,0"/>

                                                                <!-- 扫描模式选择 -->
                                                                <Grid Margin="0,12,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="80"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="扫描模式:"
                                                                                   Style="{StaticResource LabelStyle}"/>
                                                                        <ComboBox Grid.Column="1"
                                                                                  x:Name="CmbScanMode"
                                                                                  SelectedIndex="0"
                                                                                  Height="32"
                                                                                  Background="White"
                                                                                  BorderBrush="#CCCCCC"
                                                                                  BorderThickness="1"
                                                                                  Padding="8,4">
                                                                                <ComboBoxItem Content="预览模式 (Preview) - 快速/低延时"/>
                                                                                <ComboBoxItem Content="高精模式 (Precision) - 多帧平均"/>
                                                                        </ComboBox>
                                                                </Grid>
                                                        </StackPanel>
                                                </GroupBox>

                                                <!-- C. 硬件参数 -->
                                                <GroupBox x:Name="GrpParameters"
                                                          Header="C. 硬件参数 (Parameters)"
                                                          Style="{StaticResource GroupBoxStyle}">
                                                        <StackPanel>
                                                                <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="80"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="30"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="漏极电压:"
                                                                                   Style="{StaticResource LabelStyle}"/>
                                                                        <TextBox Grid.Column="1"
                                                                                 x:Name="TxtDrainVoltage"
                                                                                 Text="0.5"
                                                                                 Style="{StaticResource InputStyle}"/>
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="V"
                                                                                   Style="{StaticResource LabelStyle}"
                                                                                   Margin="8,0,0,0"/>
                                                                </Grid>

                                                                <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="80"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="TIA 量程:"
                                                                                   Style="{StaticResource LabelStyle}"/>
                                                                        <ComboBox Grid.Column="1"
                                                                                  x:Name="CmbTiaRange"
                                                                                  Style="{StaticResource ComboStyle}"
                                                                                  SelectedIndex="1">
                                                                                <ComboBoxItem Content="Range 0 (500pA)"/>
                                                                                <ComboBoxItem Content="Range 1 (500nA)"/>
                                                                                <ComboBoxItem Content="Range 2 (50uA)"/>
                                                                        </ComboBox>
                                                                </Grid>

                                                                <Grid Margin="0,0,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="80"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="30"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="建立时间:"
                                                                                   Style="{StaticResource LabelStyle}"/>
                                                                        <TextBox Grid.Column="1"
                                                                                 x:Name="TxtWaitCycles"
                                                                                 Text="20"
                                                                                 Style="{StaticResource InputStyle}"/>
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="us"
                                                                                   Style="{StaticResource LabelStyle}"
                                                                                   Margin="8,0,0,0"/>
                                                                </Grid>
                                                        </StackPanel>
                                                </GroupBox>

                                                <!-- D. 操作控制 -->
                                                <GroupBox Header="D. 操作控制 (Operations)"
                                                          Style="{StaticResource GroupBoxStyle}">
                                                        <StackPanel>
                                                                <Grid Margin="0,0,0,10">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="8"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Button Grid.Column="0"
                                                                                x:Name="BtnStart"
                                                                                Content="▶ 开始采集"
                                                                                Style="{StaticResource SuccessButton}"
                                                                                Click="BtnStart_Click"/>
                                                                        <Button Grid.Column="2"
                                                                                x:Name="BtnStop"
                                                                                Content="■ 停止采集"
                                                                                Style="{StaticResource DangerButton}"
                                                                                IsEnabled="False"
                                                                                Click="BtnStop_Click"/>
                                                                </Grid>

                                                                <Separator Margin="0,8"/>

                                                                <TextBlock Text="调试指令"
                                                                           Style="{StaticResource LabelStyle}"
                                                                           FontWeight="Medium"
                                                                           Margin="0,4,0,8"/>

                                                                <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="CmdID:"
                                                                                   Style="{StaticResource LabelStyle}"/>
                                                                        <ComboBox Grid.Column="1"
                                                                                  x:Name="CmbCmdId"
                                                                                  Style="{StaticResource ComboStyle}"
                                                                                  SelectedIndex="0">
                                                                                <ComboBoxItem Content="0 - Ping (心跳)"/>
                                                                                <ComboBoxItem Content="1 - Reset (复位)"/>
                                                                                <ComboBoxItem Content="2 - Config (配置)"/>
                                                                        </ComboBox>
                                                                </Grid>

                                                                <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="8"/>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="Param1:"
                                                                                   Style="{StaticResource LabelStyle}"/>
                                                                        <TextBox Grid.Column="1"
                                                                                 x:Name="TxtParam1"
                                                                                 Text="0"
                                                                                 Style="{StaticResource InputStyle}"/>
                                                                        <TextBlock Grid.Column="3"
                                                                                   Text="Param2:"
                                                                                   Style="{StaticResource LabelStyle}"/>
                                                                        <TextBox Grid.Column="4"
                                                                                 x:Name="TxtParam2"
                                                                                 Text="0"
                                                                                 Style="{StaticResource InputStyle}"/>
                                                                </Grid>

                                                                <Button x:Name="BtnSendCmd"
                                                                        Content="发送指令"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Click="BtnSendCmd_Click"/>
                                                        </StackPanel>
                                                </GroupBox>

                                        </StackPanel>
                                </ScrollViewer>
                        </Border>
                </Grid>

                <!-- ==================== 底部：日志窗口 ==================== -->
                <Border Grid.Row="1"
                        Background="#FFFFFF"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,12,0,0">
                        <Grid>
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 日志标题栏 -->
                                <Border Grid.Row="0"
                                        Background="#F5F5F5"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,8">
                                        <Grid>
                                                <TextBlock Text="系统日志 (System Log)"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="#333333"
                                                           VerticalAlignment="Center"/>

                                                <Button Content="清空"
                                                        HorizontalAlignment="Right"
                                                        Padding="16,4"
                                                        Background="Transparent"
                                                        BorderBrush="#CCCCCC"
                                                        Foreground="#666666"
                                                        Cursor="Hand"
                                                        Click="ClearLog_Click"/>
                                        </Grid>
                                </Border>

                                <!-- 日志内容 -->
                                <RichTextBox Grid.Row="1"
                                             x:Name="LogBox"
                                             IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="#FFFFFF"
                                             Foreground="#000000"
                                             BorderThickness="0"
                                             Padding="12,8"
                                             FontFamily="Consolas"
                                             FontSize="12">
                                        <FlowDocument>
                                                <Paragraph>
                                                        <Run Text="[系统日志] 等待初始化..."
                                                             Foreground="#888888"/>
                                                </Paragraph>
                                        </FlowDocument>
                                </RichTextBox>
                        </Grid>
                </Border>
        </Grid>
</Window>
